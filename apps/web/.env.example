# Copy this file to .env.local when you need to override local defaults.

# Local development ports.
VITE_DEV_SERVER_PORT=5173
VITE_PREVIEW_PORT=4173

# The backend used by the Vite dev/preview proxy.
# When omitted, it defaults to http://localhost:${SERVER_PORT:-8080} so the
# proxy follows the backend port when SERVER_PORT is set.
# VITE_API_PROXY_TARGET=http://localhost:8080

# Leave empty to use same-origin `/api` requests through the Vite proxy.
# For a split deployment, use the public backend origin (no trailing slash,
# no `/api` suffix), for example https://api.example.com.
VITE_API_BASE_URL=

# Optional Swagger UI URL override. When empty, it is derived from
# VITE_API_BASE_URL, or falls back to /swagger-ui.html in local development.
VITE_API_DOCS_URL=

# GitHub Pages project sites use /<repository>/.
# A user/organization site or a custom domain uses /.
VITE_BASE_PATH=/
