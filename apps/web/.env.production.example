# Example split deployment: GitHub Pages frontend + Lighthouse backend.
# Copy to .env.production.local and adjust the values before a production build.

# For https://<username>.github.io/campus-shop/ use /campus-shop/.
# For https://<username>.github.io/ or a custom domain use /.
VITE_BASE_PATH=/campus-shop/

# Public HTTPS origin of the Spring Boot API. Do not include /api or a trailing slash.
VITE_API_BASE_URL=https://api.example.com

# Optional. When omitted, the app links to <VITE_API_BASE_URL>/swagger-ui.html.
# VITE_API_DOCS_URL=https://api.example.com/swagger-ui.html
